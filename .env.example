# --- Aplikace ---
# Tajný klíč pro session cookies (prázdné = vygeneruje se do souboru .secret_key):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Zobrazovaná jména profilů
DEPUTY_NAME=Michal
ASSISTANT_NAME=Hanka
# Upozornění asistentce na úkoly od náměstka (e-mail a SMS; u úkolu lze vypnout)
ASSISTANT_EMAIL=
ASSISTANT_PHONE=
# Kontakty náměstka pro upozornění na jeho soukromé úkoly
DEPUTY_EMAIL=
DEPUTY_PHONE=
# Hesla pro přihlášení jednotlivých rolí (prázdné = přihlášení bez hesla, jen pro vývoj)
DEPUTY_PASSWORD=zmen-me
ASSISTANT_PASSWORD=zmen-me
# SQLAlchemy URL; pro PostgreSQL/Supabase např. postgresql+psycopg://user:pass@host:5432/db
# Výchozí: soubor assistplanner.db ve složce aplikace
# DATABASE_URL=sqlite:////home/UZIVATEL/assistplanner/assistplanner.db
# Časové pásmo pro "dnes", briefing a události v kalendáři
APP_TIMEZONE=Europe/Prague
# Naplnit prázdnou databázi ukázkovými daty (1/0)
SEED_DEMO_DATA=1

# --- OpenAI (Whisper + strukturování + briefing) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Microsoft Graph (Outlook kalendář, App Registration s client secret) ---
# Aplikace potřebuje Application permission Calendars.ReadWrite (admin consent)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# UPN / e-mail schránek, do jejichž kalendářů se zapisuje
MS_DEPUTY_MAILBOX=namestek@example.cz
MS_ASSISTANT_MAILBOX=asistentka@example.cz
# Výchozí délka události v minutách
CALENDAR_EVENT_MINUTES=60

# --- SMS přes Twilio (https://www.twilio.com) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Odesílací číslo z Twilia ve formátu +1...
TWILIO_FROM=

# --- Notifikace ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Volitelný obecný webhook (POST JSON {"text": ...}), např. Teams/Slack
NOTIFY_WEBHOOK_URL=
# --- E-mail (SMTP) pro upozornění ---
# Gmail:            SMTP_HOST=smtp.gmail.com     SMTP_PORT=587  (heslo aplikace)
# Seznam:           SMTP_HOST=smtp.seznam.cz     SMTP_PORT=465
# Microsoft 365:    SMTP_HOST=smtp.office365.com SMTP_PORT=587  (musí mít povolené SMTP AUTH)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Adresa odesílatele (obvykle stejná jako SMTP_USER) a zobrazované jméno
SMTP_FROM=
SMTP_FROM_NAME=Syncho
# ssl / starttls / none – prázdné = automaticky podle portu (465 → ssl)
SMTP_SECURITY=
# Volitelně: společná schránka pro hromadná upozornění (urgentní úkoly, závazky do 24 h)
NOTIFY_EMAIL_TO=
